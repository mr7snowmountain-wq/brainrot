# ─────────────────────────────────────────────────────────────
# BRAINROT — variables d'entité
# Copie ce fichier en `.env`. Tant qu'une valeur reste un
# placeholder (préfixe __ ), le build de PRODUCTION est refusé ;
# en développement il passe avec un avertissement.
#
# Le nom de marque est une VARIABLE : il n'est écrit en dur nulle
# part dans le code. Changer BRAND_NAME renomme tout le site.
# ─────────────────────────────────────────────────────────────

# Identité
BRAND_NAME=Brainrot
SITE_URL=https://brainrotstudio.fr
AUTHOR_NAME=La rédaction Brainrot
CONTACT_EMAIL=__CONTACT_EMAIL__
LOGO_PATH=/logo.png

# Réseaux (sameAs) — à remplir AVANT la mise en ligne, pas avant de coder.
# TikTok = priorité n°1 pour cette audience.
TIKTOK_URL=__TIKTOK_URL__
INSTAGRAM_URL=__INSTAGRAM_URL__
YOUTUBE_URL=__YOUTUBE_URL__

# Description canonique (doit être IDENTIQUE partout : site, réseaux, mentions légales)
BRAND_TAGLINE=Le média de la Gen Z qui joue : gaming, séries, anime, musique et culture web.

# Pinterest (diffusion auto) — remplir avant d'activer pin:publish
PINTEREST_ACCESS_TOKEN=__PINTEREST_ACCESS_TOKEN__
PINTEREST_BOARD_ID=__PINTEREST_BOARD_ID__
