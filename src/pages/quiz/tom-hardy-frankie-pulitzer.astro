---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Quiz — Tom Hardy en rappeur masqué (19 questions du client, 20e « vibe check »
// retirée). Position de la bonne réponse VARIÉE. c = index correct.
const QUESTIONS = [
  { q: "Le pseudo de rappeur masqué de Tom Hardy s'appelle comment ?", o: ['Bane Beats', 'Frankie Pulitzer', 'Tom the Rapper', 'DJ Venom'], c: 1 },
  { q: "Frankie Pulitzer est apparu pour la première fois en quelle année ?", o: ['2015', '2021', '2024', 'Cette année seulement'], c: 1 },
  { q: "Le groupe avec lequel Tom Hardy collabore s'appelle comment ?", o: ['Czarface', 'Wu-Tang Clan directement', 'Bad Boy Records', 'Death Row'], c: 0 },
  { q: "Method Man est membre fondateur de quel groupe légendaire du hip-hop ?", o: ['N.W.A', 'Public Enemy', 'Wu-Tang Clan', 'Run-D.M.C.'], c: 2 },
  { q: "Le titre en featuring avec Method Man s'appelle comment ?", o: ["Bane's Revenge", 'Mad Technology', 'Dark Knight Flow', 'Venom Bars'], c: 1 },
  { q: "Combien de titres compte l'album Czarface Meets Frankie Pulitzer ?", o: ['3', '50', '15', 'Un seul'], c: 2 },
  { q: "Tom Hardy porte quoi sur le visage dans les clips et sur scène ?", o: ['Un masque de Venom', 'Une cagoule intégrale noire et blanche', 'Rien, visage découvert', 'Des lunettes de soleil uniquement'], c: 1 },
  { q: "Sur quel titre de l'album Hardy reprend-il sa voix de Bane ?", o: ['Mad Technology', 'Grim-Visaged War', 'Aucun titre', "Sur tout l'album en continu"], c: 1 },
  { q: "Quel monologue shakespearien Hardy livre-t-il avec sa voix de Bane ?", o: ["L'ouverture de Richard III", 'Hamlet en entier', 'Roméo et Juliette', 'Aucun texte de Shakespeare'], c: 0 },
  { q: "Frankie Pulitzer était lié à quel film Marvel lors de sa première apparition en 2021 ?", o: ['Thor Ragnarok', 'Venom: Let There Be Carnage', 'Spider-Man No Way Home', 'Aucun film Marvel'], c: 1 },
  { q: "Tom Hardy a-t-il officiellement confirmé être Frankie Pulitzer ?", o: ['Oui, en interview complète', 'Oui, sur les réseaux sociaux', 'Non, jamais publiquement', "La question n'a jamais été posée"], c: 2 },
  { q: "En 2024, Frankie Pulitzer apparaît sur quel titre, déjà avec Method Man ?", o: ['Knull & Void', 'Mad Technology déjà', 'Aucun titre en 2024', 'Un featuring avec un autre acteur'], c: 0 },
  { q: "Method Man est né dans quelle ville américaine ?", o: ['Los Angeles', 'Chicago', 'Hempstead, New York', 'Atlanta'], c: 2 },
  { q: "Quel artiste est cité dans Mad Technology, en plus des références Stephen King ?", o: ['Leonardo DiCaprio', 'Shameik Moore', 'Denzel Washington', 'Aucun autre artiste cité'], c: 1 },
  { q: "Le style musical général de Czarface est classé dans quelle catégorie ?", o: ['Musique classique', 'Hip-hop / boom-bap', 'Électro pure', 'Country'], c: 1 },
  { q: "Une réaction virale à Mad Technology s'intitule comment, façon titre choc ?", o: ['Tom Hardy arrête le cinéma', '« Bane a des punchlines ?! »', "Le pire album de l'année", 'Aucun titre de ce genre'], c: 1 },
  { q: "Method Man a reçu un Grammy pour quelle catégorie dans sa carrière ?", o: ["Meilleur album de l'année", 'Meilleure performance rap en duo ou groupe', 'Aucun Grammy jamais reçu', 'Meilleur acteur'], c: 1 },
  { q: "L'album de Method Man sorti en 2022 s'appelle comment ?", o: ['Tical 2022', 'Meth Lab Season 3: The Rehab', 'Frankie Pulitzer Meets Meth', 'Aucun album en 2022'], c: 1 },
  { q: "Le personnage de Frankie Pulitzer est décrit par la presse comme quoi ?", o: ['De vraies barres, pas un projet vanité', 'Une blague complète sans intérêt', 'De la musique classique déguisée', "Personne n'en parle sérieusement"], c: 0 },
];
---
<BaseLayout
  title="Quiz Tom Hardy rappeur : 19 questions sur Frankie Pulitzer"
  description="Frankie Pulitzer, Czarface, Method Man, la voix de Bane sur du Shakespeare : 19 questions sur la double vie rap de Tom Hardy. Tu connais l'historique, ou tu découvres tout ?"
  canonicalPath="/quiz/tom-hardy-frankie-pulitzer"
  category="musique"
>
  <div class="quiz" data-quiz>
    <p class="eyebrow">Quiz musique</p>
    <h1>Tu connais la double vie rap de Tom Hardy ?</h1>
    <p class="quiz-lede">19 questions sur Frankie Pulitzer, Czarface et Method Man. La bonne réponse est planquée au milieu de trois pièges. On compte les points.</p>

    <div class="quiz-stage" data-stage>
      <div class="quiz-progress"><span data-bar></span></div>
      <p class="quiz-count" data-count></p>
      <p class="quiz-q" data-q></p>
      <div class="quiz-options" data-options></div>
      <p class="quiz-note-line" data-note hidden></p>
      <button class="btn-primary quiz-next" data-next hidden>Question suivante →</button>
    </div>

    <div class="quiz-end" data-end hidden>
      <h2>Terminé 🎭</h2>
      <p>Ton score : <strong data-score></strong> / <strong data-total></strong></p>
      <p class="quiz-verdict" data-verdict></p>
      <button class="btn-secondary" data-restart>Recommencer</button>
    </div>
  </div>

  <script is:inline define:vars={{ QUESTIONS }}>
    (() => {
      const root = document.querySelector('[data-quiz]');
      if (!root) return;
      const $ = (s) => root.querySelector(s);
      const stage = $('[data-stage]'), end = $('[data-end]');
      const bar = $('[data-bar]'), count = $('[data-count]'), qEl = $('[data-q]');
      const optWrap = $('[data-options]'), noteEl = $('[data-note]'), next = $('[data-next]');
      let i = 0, score = 0, locked = false;

      function render() {
        const Q = QUESTIONS[i];
        bar.style.width = (i / QUESTIONS.length * 100) + '%';
        count.textContent = 'Question ' + (i + 1) + ' / ' + QUESTIONS.length;
        qEl.textContent = Q.q;
        optWrap.innerHTML = '';
        noteEl.hidden = true; noteEl.textContent = ''; next.hidden = true;
        locked = false;
        Q.o.forEach((opt, k) => {
          const b = document.createElement('button');
          b.className = 'quiz-opt';
          b.textContent = opt;
          b.addEventListener('click', () => choose(k));
          optWrap.appendChild(b);
        });
      }
      function choose(k) {
        if (locked) return;
        locked = true;
        const Q = QUESTIONS[i];
        const btns = [...optWrap.children];
        btns.forEach((b, idx) => {
          b.disabled = true;
          if (idx === Q.c) b.classList.add('is-correct');
          else if (idx === k) b.classList.add('is-wrong');
        });
        if (k === Q.c) score++;
        noteEl.hidden = false;
        noteEl.textContent = (k === Q.c ? 'Bien vu. ' : 'Raté. ') + (Q.note || '');
        next.hidden = false;
        next.textContent = (i + 1 >= QUESTIONS.length) ? 'Voir mon score →' : 'Question suivante →';
      }
      next.addEventListener('click', () => {
        i++;
        if (i >= QUESTIONS.length) {
          stage.hidden = true; end.hidden = false;
          $('[data-score]').textContent = score;
          $('[data-total]').textContent = QUESTIONS.length;
          const pct = score / QUESTIONS.length;
          $('[data-verdict]').textContent =
            pct === 1 ? 'Parfait. Tu suis Frankie depuis 2021, toi.' :
            pct >= 0.8 ? 'Solide. Tu connais le dossier.' :
            pct >= 0.5 ? 'Correct, mais t\'as des trous.' :
            'Aïe. Tu découvres tout en même temps que tout le monde.';
        } else render();
      });
      $('[data-restart]').addEventListener('click', () => { i = 0; score = 0; end.hidden = true; stage.hidden = false; render(); });
      render();
    })();
  </script>

  <style>
    .quiz { max-width: 42rem; margin: 1.5rem auto 3rem; padding: 0 1.25rem; }
    .quiz h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem, 6vw, 2.7rem); letter-spacing: -.02em; margin: .4rem 0 .5rem; }
    .quiz-lede { color: var(--fg-soft); margin: 0 0 1.6rem; }
    .quiz-stage { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 1.4rem 1.4rem 1.6rem; }
    .quiz-progress { height: 6px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; margin-bottom: 1rem; }
    .quiz-progress span { display: block; height: 100%; background: var(--grad); transition: width .3s; }
    .quiz-count { font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-dim); margin: 0 0 .6rem; }
    .quiz-q { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; line-height: 1.25; margin: 0 0 1.1rem; }
    .quiz-options { display: flex; flex-direction: column; gap: .6rem; }
    :global(.quiz-opt) {
      text-align: left; padding: .9rem 1.15rem; border-radius: 16px; border: 1px solid rgba(166,121,255,.5);
      background: linear-gradient(105deg, rgba(166,121,255,.28), rgba(255,111,179,.22), rgba(88,199,255,.26)); color: var(--fg); font: inherit; font-size: 1rem; cursor: pointer;
      -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      transition: border-color .15s, background .15s, transform .12s, box-shadow .15s;
    }
    :global(.quiz-opt:hover:not(:disabled)) {
      border-color: var(--violet); background: linear-gradient(105deg, rgba(166,121,255,.45), rgba(255,111,179,.36), rgba(88,199,255,.4));
      transform: translateY(-1px); box-shadow: 0 6px 20px -12px rgba(166,121,255,.7);
    }
    :global(.quiz-opt:disabled) { cursor: default; }
    :global(.quiz-opt.is-correct) { border-color: transparent; background: var(--grad); color: #14101f; font-weight: 700; box-shadow: 0 8px 24px -12px rgba(255,111,179,.6); }
    :global(.quiz-opt.is-wrong) { border-color: rgba(239,68,68,.55); background: rgba(239,68,68,.14); }
    .quiz-note-line { margin: 1rem 0 0; font-size: .9rem; color: var(--fg-soft); }
    .quiz-next { margin-top: 1.1rem; }
    .quiz-end { text-align: center; background: var(--grad-soft); border: 1px solid var(--line-strong); border-radius: 20px; padding: 2rem 1.5rem; margin-top: 1rem; }
    .quiz-end h2 { font-family: var(--font-display); font-weight: 800; margin: 0 0 .6rem; }
    .quiz-verdict { color: var(--fg-soft); max-width: 32rem; margin: .8rem auto 1.4rem; font-size: 1rem; }
  </style>
</BaseLayout>
