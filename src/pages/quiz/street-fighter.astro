---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Quiz de LORE — Street Fighter (19 questions fournies par le client, la 20e
// « vibe check » retirée car sans réponse unique). Q1 reformulée : Hadoken est
// une attaque à distance, pas un « coup tourbillonnant ». Distracteurs gardés,
// position de la bonne réponse VARIÉE. c = index de la bonne réponse.
const QUESTIONS = [
  { q: "L'attaque à distance emblématique de Ryu, la boule d'énergie, s'appelle comment ?", o: ['Shoryuken', 'Hadoken', 'Tatsumaki', 'Hurricane Kick'], c: 1 },
  { q: "Le « Shoryuken », c'est quel type de coup exactement ?", o: ['Une projection au sol', 'Un uppercut sauté', 'Un coup de pied circulaire', "Une boule d'énergie"], c: 1 },
  { q: "Qui a introduit à Ryu le concept du Satsui no Hado, la voie sombre du combat ?", o: ['Ken', 'Gouken', 'Akuma', 'M. Bison'], c: 2 },
  { q: "Le Satsui no Hado, littéralement, ça veut dire quoi ?", o: ['Le poing de la justice', "L'esprit du dragon", "La vague de l'intention meurtrière", 'La force ultime'], c: 2, note: "Terme souvent traduit différemment selon les versions." },
  { q: "Qui est le vrai maître qui a entraîné Ryu et Ken, avant même Akuma ?", o: ['Sagat', 'Gouken', 'Guile', 'Dhalsim'], c: 1 },
  { q: "Comment Akuma a-t-il « tué » son propre frère Gouken, selon le lore original ?", o: ["Il ne l'a jamais tué", 'En combat, devant Ryu et Ken enfants', 'Par empoisonnement', 'Ce sont des jumeaux, aucun conflit'], c: 1, note: "Point retconné plusieurs fois : Gouken est réapparu vivant dans des jeux ultérieurs." },
  { q: "Quel style d'arts martiaux pratiquent réellement Ryu, Ken et Akuma, au-delà du simple « karaté » ?", o: ['Le judo pur', 'Le kung-fu Shaolin', "L'Ansatsuken", 'La boxe thaï'], c: 2 },
  { q: "Le personnage qui incarne un Ryu totalement consumé par le côté sombre s'appelle comment ?", o: ['Dark Ryu', 'Evil Ryu', 'Shadow Ryu', "Aucun nom, ça n'existe pas"], c: 1 },
  { q: "La forme ultime d'Akuma, quand il est totalement dévoré par sa noirceur, s'appelle comment ?", o: ['Evil Akuma', 'Dark Gouki', 'Oni', 'Le Démon Final'], c: 2 },
  { q: "Sagat porte une cicatrice célèbre sur le torse. Elle vient de quel coup ?", o: ['Une blessure de guerre', "Un coup d'Akuma", 'Un Shoryuken de Ryu dans le premier Street Fighter', "Il n'a aucune cicatrice"], c: 2 },
  { q: "Dans quel jeu les trois coups signatures étaient-ils des secrets à découvrir par le joueur ?", o: ['Street Fighter II', 'Le tout premier Street Fighter de 1987', 'Street Fighter V', 'Ils ont toujours été affichés clairement'], c: 1 },
  { q: "Combien de personnages jouables comptait le tout premier Street Fighter en 1987 ?", o: ['12', '2 (Ryu et Ken)', '6', 'Un seul, Ryu uniquement'], c: 1 },
  { q: "Qui organise en secret le tournoi World Warrior dans Street Fighter II ?", o: ['La police internationale', "Shadaloo, l'organisation de M. Bison", 'Gouken lui-même', 'Personne, un tournoi ouvert classique'], c: 1 },
  { q: "Le bandeau rouge que porte Ryu dans certaines versions, il vient de qui ?", o: ["C'est un cadeau de Chun-Li", 'Ken le lui donne', "Il l'a depuis son enfance", 'Aucune origine connue dans le lore'], c: 1 },
  { q: "Quelle rivale/alliée dit à Ryu qu'il ne peut vaincre Bison qu'au prix de son âme ?", o: ['Chun-Li', 'Cammy', 'Rose', 'Sakura'], c: 2 },
  { q: "Quel pouvoir Bison utilise-t-il pour manipuler et contrôler ses adversaires ?", o: ['Le Satsui no Hado, comme Akuma', 'Le Psycho Power', 'Une simple hypnose classique', 'Aucun pouvoir spécial'], c: 1 },
  { q: "Sakura, jeune fan de Ryu apparue plus tard, fait quoi de spécial dans l'histoire ?", o: ['Elle bat Bison seule', 'Elle aide Ryu à surmonter ses doutes existentiels', 'Elle est en réalité la sœur de Ryu', "Elle n'a aucun rôle dans le scénario"], c: 1 },
  { q: "Dans quelle licence crossover Ryu est-il apparu comme personnage jouable ?", o: ['Uniquement dans les jeux Capcom', 'Mortal Kombat', 'Super Smash Bros.', 'Aucun crossover jamais fait'], c: 2 },
  { q: "Le combat entre Ryu et Akuma sur une île isolée, tôt dans le lore, se déroule où ?", o: ['À Bangkok', "Sur l'île de Gokuentou", 'Dans le désert de Thaïlande', "Ce combat n'existe pas dans le lore"], c: 1, note: "Détail de lore débattu selon les sources." },
];
---
<BaseLayout
  title="Quiz Street Fighter : 19 questions de vrai lore"
  description="Satsui no Hado, Gouken, l'île de Gokuentou, le premier Street Fighter de 1987 : 19 questions de lore pour les vrais connaisseurs de la licence, pas juste ceux qui ont vu le trailer du film."
  canonicalPath="/quiz/street-fighter"
  category="jeux-video"
>
  <div class="quiz" data-quiz>
    <p class="eyebrow">Quiz Street Fighter</p>
    <h1>Tu connais le vrai lore, ou juste le casting du film ?</h1>
    <p class="quiz-lede">19 questions bien plus profondes que la bande-annonce. Satsui no Hado, Ansatsuken, l'île de Gokuentou : la bonne réponse est planquée au milieu de trois pièges. On compte les points.</p>

    <div class="quiz-stage" data-stage>
      <div class="quiz-progress"><span data-bar></span></div>
      <p class="quiz-count" data-count></p>
      <p class="quiz-q" data-q></p>
      <div class="quiz-options" data-options></div>
      <p class="quiz-note-line" data-note hidden></p>
      <button class="btn-primary quiz-next" data-next hidden>Question suivante →</button>
    </div>

    <div class="quiz-end" data-end hidden>
      <h2>Terminé 🥋</h2>
      <p>Ton score : <strong data-score></strong> / <strong data-total></strong></p>
      <p class="quiz-verdict" data-verdict></p>
      <button class="btn-secondary" data-restart>Recommencer</button>
    </div>
  </div>

  <script is:inline define:vars={{ QUESTIONS }}>
    (() => {
      const root = document.querySelector('[data-quiz]');
      if (!root) return;
      const $ = (s) => root.querySelector(s);
      const stage = $('[data-stage]'), end = $('[data-end]');
      const bar = $('[data-bar]'), count = $('[data-count]'), qEl = $('[data-q]');
      const optWrap = $('[data-options]'), noteEl = $('[data-note]'), next = $('[data-next]');
      let i = 0, score = 0, locked = false;

      function render() {
        const Q = QUESTIONS[i];
        bar.style.width = (i / QUESTIONS.length * 100) + '%';
        count.textContent = 'Question ' + (i + 1) + ' / ' + QUESTIONS.length;
        qEl.textContent = Q.q;
        optWrap.innerHTML = '';
        noteEl.hidden = true; noteEl.textContent = ''; next.hidden = true;
        locked = false;
        Q.o.forEach((opt, k) => {
          const b = document.createElement('button');
          b.className = 'quiz-opt';
          b.textContent = opt;
          b.addEventListener('click', () => choose(k));
          optWrap.appendChild(b);
        });
      }
      function choose(k) {
        if (locked) return;
        locked = true;
        const Q = QUESTIONS[i];
        const btns = [...optWrap.children];
        btns.forEach((b, idx) => {
          b.disabled = true;
          if (idx === Q.c) b.classList.add('is-correct');
          else if (idx === k) b.classList.add('is-wrong');
        });
        if (k === Q.c) score++;
        noteEl.hidden = false;
        noteEl.textContent = (k === Q.c ? 'Bien vu. ' : 'Raté. ') + (Q.note || '');
        next.hidden = false;
        next.textContent = (i + 1 >= QUESTIONS.length) ? 'Voir mon score →' : 'Question suivante →';
      }
      next.addEventListener('click', () => {
        i++;
        if (i >= QUESTIONS.length) {
          stage.hidden = true; end.hidden = false;
          $('[data-score]').textContent = score;
          $('[data-total]').textContent = QUESTIONS.length;
          const pct = score / QUESTIONS.length;
          $('[data-verdict]').textContent =
            pct === 1 ? 'Parfait. Tu maîtrises l’Ansatsuken mieux que Ryu.' :
            pct >= 0.8 ? 'Niveau boss final. Tes potes n’ont aucune chance.' :
            pct >= 0.5 ? 'Correct, mais Akuma te met encore KO.' :
            'Aïe. T’as regardé le trailer, pas joué aux jeux.';
        } else render();
      });
      $('[data-restart]').addEventListener('click', () => { i = 0; score = 0; end.hidden = true; stage.hidden = false; render(); });
      render();
    })();
  </script>

  <style>
    .quiz { max-width: 42rem; margin: 1.5rem auto 3rem; padding: 0 1.25rem; }
    .quiz h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem, 6vw, 2.7rem); letter-spacing: -.02em; margin: .4rem 0 .5rem; }
    .quiz-lede { color: var(--fg-soft); margin: 0 0 1.6rem; }
    .quiz-stage { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 1.4rem 1.4rem 1.6rem; }
    .quiz-progress { height: 6px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; margin-bottom: 1rem; }
    .quiz-progress span { display: block; height: 100%; background: var(--grad); transition: width .3s; }
    .quiz-count { font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-dim); margin: 0 0 .6rem; }
    .quiz-q { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; line-height: 1.25; margin: 0 0 1.1rem; }
    .quiz-options { display: flex; flex-direction: column; gap: .6rem; }
    :global(.quiz-opt) {
      text-align: left; padding: .9rem 1.15rem; border-radius: 16px; border: 1px solid rgba(166,121,255,.5);
      background: linear-gradient(105deg, rgba(166,121,255,.28), rgba(255,111,179,.22), rgba(88,199,255,.26)); color: var(--fg); font: inherit; font-size: 1rem; cursor: pointer;
      -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      transition: border-color .15s, background .15s, transform .12s, box-shadow .15s;
    }
    :global(.quiz-opt:hover:not(:disabled)) {
      border-color: var(--violet); background: linear-gradient(105deg, rgba(166,121,255,.45), rgba(255,111,179,.36), rgba(88,199,255,.4));
      transform: translateY(-1px); box-shadow: 0 6px 20px -12px rgba(166,121,255,.7);
    }
    :global(.quiz-opt:disabled) { cursor: default; }
    :global(.quiz-opt.is-correct) { border-color: transparent; background: var(--grad); color: #14101f; font-weight: 700; box-shadow: 0 8px 24px -12px rgba(255,111,179,.6); }
    :global(.quiz-opt.is-wrong) { border-color: rgba(239,68,68,.55); background: rgba(239,68,68,.14); }
    .quiz-note-line { margin: 1rem 0 0; font-size: .9rem; color: var(--fg-soft); }
    .quiz-next { margin-top: 1.1rem; }
    .quiz-end { text-align: center; background: var(--grad-soft); border: 1px solid var(--line-strong); border-radius: 20px; padding: 2rem 1.5rem; margin-top: 1rem; }
    .quiz-end h2 { font-family: var(--font-display); font-weight: 800; margin: 0 0 .6rem; }
    .quiz-verdict { color: var(--fg-soft); max-width: 32rem; margin: .8rem auto 1.4rem; font-size: 1rem; }
  </style>
</BaseLayout>
