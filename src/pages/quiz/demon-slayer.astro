---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Quiz de CONNAISSANCE — Demon Slayer (19 questions fournies par le client,
// la 20e « résume en un mot » retirée car sans réponse unique). Distracteurs
// gardés drôles, NE PAS les aplatir. Position de la bonne réponse VARIÉE.
// c = index de la bonne réponse. `note` = complément affiché à la révélation.
const QUESTIONS = [
  { q: "Tanjiro, il fait quoi comme métier avant que sa vie parte en vrille ?", o: ['Vendeur de charbon', 'Pêcheur', 'Forgeron', 'Marchand ambulant'], c: 0 },
  { q: "Nezuko, sa petite sœur, elle devient quoi après l'attaque ?", o: ['Une chasseuse de démons', 'Une prêtresse', 'Une démone', 'Rien, elle reste humaine'], c: 2 },
  { q: "L'organisation qui recrute Tanjiro pour combattre les démons s'appelle comment ?", o: ['La Guilde des ombres', 'Le Corps des pourfendeurs de démons', "L'Ordre du soleil", 'Les Chasseurs Nocturnes'], c: 1 },
  { q: "Le grade le plus élevé chez les chasseurs de démons, celui que tout le monde respecte ?", o: ['Maître Suprême', 'Légende', "Sabreur d'Or", 'Hashira / Pilier'], c: 3 },
  { q: "Muzan Kibutsuji, c'est qui dans l'histoire, poste officiel ?", o: ['Un simple sbire', "Le démon originel, à l'origine de tous les autres", 'Le meilleur ami de Tanjiro', 'Un chasseur de démons raté'], c: 1 },
  { q: "La technique de combat de Tanjiro s'appelle comment, en gros ?", o: ["Respiration de l'eau", 'Respiration du feu', 'Souffle du dragon', 'Aucune technique spéciale'], c: 0 },
  { q: "Zenitsu, l'ami peureux de Tanjiro, il devient badass quand exactement ?", o: ['Jamais, il reste peureux tout le temps', 'Uniquement en pleine lune', 'Quand il dort / perd connaissance', 'Après avoir mangé'], c: 2 },
  { q: "Inosuke porte quoi sur la tête en permanence, détail iconique ?", o: ['Un masque de démon', 'Une tête de sanglier', 'Un casque de samouraï', 'Rien, il est toujours tête nue'], c: 1 },
  { q: "Le village où vivent les forgerons qui fabriquent les sabres, il s'appelle comment ?", o: ['Village des forgerons', 'Village de la lune', 'Village caché', 'Village des ombres'], c: 0 },
  { q: "Les Lunes Démoniaques (Kizuki), l'élite de Muzan, ça fait combien de démons en tout ?", o: ['12', '5', '20', '3'], c: 0, note: "Six Lunes Supérieures + six Lunes Inférieures = douze au total." },
  { q: "Nezuko a une particularité qui la distingue des autres démons, laquelle ?", o: ['Elle est immortelle totale', 'Elle contrôle le feu', 'Elle a des pouvoirs psychiques', "Elle ne mange pas d'humains"], c: 3 },
  { q: "Le sabre des chasseurs de démons change de couleur selon quoi, exactement ?", o: ['La météo du jour', "L'humeur du combattant", 'Le type de respiration du porteur', 'Rien, ils sont tous identiques'], c: 2 },
  { q: "Rengoku, le pilier de la flamme, il apparaît surtout dans quel film culte de la franchise ?", o: ['Le Village des forgerons', "Le Train de l'Infini", "L'Entraînement des piliers", 'Aucun film, il reste dans la série'], c: 1 },
  { q: "Le studio qui anime Demon Slayer s'appelle comment ?", o: ['Ufotable', 'MAPPA', 'Studio Ghibli', 'Toei Animation'], c: 0 },
  { q: "Combien de temps s'écoule avant que Tanjiro parte chercher un moyen de sauver Nezuko ?", o: ['Dix ans plus tard', 'Il ne part jamais', "Après avoir fini l'école", "Il part quasiment tout de suite après l'attaque"], c: 3 },
  { q: "L'arc qui se déroule dans un quartier de plaisirs, célèbre pour son ambiance et ses combats ?", o: ["L'arc du Quartier des plaisirs", "L'arc du Village caché", "L'arc de la Lune", "L'arc du Sanctuaire"], c: 0 },
  { q: "Le grand arc qui doit conclure l'histoire, il s'appelle comment ?", o: ["L'arc Final Boss", "L'arc de la Vengeance", "L'arc du Château de l'Infini", "L'arc du Renouveau"], c: 2, note: "Aussi traduit « Forteresse Infinie »." },
  { q: "Le manga original de Demon Slayer, il est écrit par qui ?", o: ['Koyoharu Gotouge', 'Eiichiro Oda', 'Akira Toriyama', 'Masashi Kishimoto'], c: 0 },
  { q: "La respiration originelle, celle dont dérivent toutes les autres techniques, elle porte quel nom ?", o: ['Respiration de la Lune', 'Respiration du Soleil', 'Respiration Primordiale', 'Respiration du Vide'], c: 1 },
];
---
<BaseLayout
  title="Quiz Demon Slayer : 19 questions pour les vrais"
  description="Tanjiro, Nezuko, les Piliers, Muzan, Ufotable : 19 questions de connaissance Demon Slayer avec des mauvaises réponses écrites pour te faire rire. Tu tiens combien avant de craquer ?"
  canonicalPath="/quiz/demon-slayer"
  category="anime"
>
  <div class="quiz" data-quiz>
    <p class="eyebrow">Quiz Demon Slayer</p>
    <h1>Tu connais vraiment Demon Slayer ?</h1>
    <p class="quiz-lede">19 questions, du souffle de l'eau au Château de l'Infini. La bonne réponse est planquée au milieu de trois qui vont te faire douter. On compte les points.</p>

    <div class="quiz-stage" data-stage>
      <div class="quiz-progress"><span data-bar></span></div>
      <p class="quiz-count" data-count></p>
      <p class="quiz-q" data-q></p>
      <div class="quiz-options" data-options></div>
      <p class="quiz-note-line" data-note hidden></p>
      <button class="btn-primary quiz-next" data-next hidden>Question suivante →</button>
    </div>

    <div class="quiz-end" data-end hidden>
      <h2>Terminé ⚔️</h2>
      <p>Ton score : <strong data-score></strong> / <strong data-total></strong></p>
      <p class="quiz-verdict" data-verdict></p>
      <button class="btn-secondary" data-restart>Recommencer</button>
    </div>
  </div>

  <script is:inline define:vars={{ QUESTIONS }}>
    (() => {
      const root = document.querySelector('[data-quiz]');
      if (!root) return;
      const $ = (s) => root.querySelector(s);
      const stage = $('[data-stage]'), end = $('[data-end]');
      const bar = $('[data-bar]'), count = $('[data-count]'), qEl = $('[data-q]');
      const optWrap = $('[data-options]'), noteEl = $('[data-note]'), next = $('[data-next]');
      let i = 0, score = 0, locked = false;

      function render() {
        const Q = QUESTIONS[i];
        bar.style.width = (i / QUESTIONS.length * 100) + '%';
        count.textContent = 'Question ' + (i + 1) + ' / ' + QUESTIONS.length;
        qEl.textContent = Q.q;
        optWrap.innerHTML = '';
        noteEl.hidden = true; noteEl.textContent = ''; next.hidden = true;
        locked = false;
        Q.o.forEach((opt, k) => {
          const b = document.createElement('button');
          b.className = 'quiz-opt';
          b.textContent = opt;
          b.addEventListener('click', () => choose(k));
          optWrap.appendChild(b);
        });
      }
      function choose(k) {
        if (locked) return;
        locked = true;
        const Q = QUESTIONS[i];
        const btns = [...optWrap.children];
        btns.forEach((b, idx) => {
          b.disabled = true;
          if (idx === Q.c) b.classList.add('is-correct');
          else if (idx === k) b.classList.add('is-wrong');
        });
        if (k === Q.c) score++;
        noteEl.hidden = false;
        noteEl.textContent = (k === Q.c ? 'Bien vu. ' : 'Raté. ') + (Q.note || '');
        next.hidden = false;
        next.textContent = (i + 1 >= QUESTIONS.length) ? 'Voir mon score →' : 'Question suivante →';
      }
      next.addEventListener('click', () => {
        i++;
        if (i >= QUESTIONS.length) {
          stage.hidden = true; end.hidden = false;
          $('[data-score]').textContent = score;
          $('[data-total]').textContent = QUESTIONS.length;
          const pct = score / QUESTIONS.length;
          $('[data-verdict]').textContent =
            pct === 1 ? 'Parfait. Le Corps des pourfendeurs te recrute direct.' :
            pct >= 0.8 ? 'Niveau Pilier. Tes potes peuvent rentrer chez eux.' :
            pct >= 0.5 ? 'Correct, mais Muzan te croque encore.' :
            'Aïe. Retourne regarder la saison 1 avant de la ramener.';
        } else render();
      });
      $('[data-restart]').addEventListener('click', () => { i = 0; score = 0; end.hidden = true; stage.hidden = false; render(); });
      render();
    })();
  </script>

  <style>
    .quiz { max-width: 42rem; margin: 1.5rem auto 3rem; padding: 0 1.25rem; }
    .quiz h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem, 6vw, 2.7rem); letter-spacing: -.02em; margin: .4rem 0 .5rem; }
    .quiz-lede { color: var(--fg-soft); margin: 0 0 1.6rem; }
    .quiz-stage { background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 1.4rem 1.4rem 1.6rem; }
    .quiz-progress { height: 6px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; margin-bottom: 1rem; }
    .quiz-progress span { display: block; height: 100%; background: var(--grad); transition: width .3s; }
    .quiz-count { font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-dim); margin: 0 0 .6rem; }
    .quiz-q { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; line-height: 1.25; margin: 0 0 1.1rem; }
    .quiz-options { display: flex; flex-direction: column; gap: .6rem; }
    :global(.quiz-opt) {
      text-align: left; padding: .9rem 1.15rem; border-radius: 16px; border: 1px solid rgba(166,121,255,.5);
      background: linear-gradient(105deg, rgba(166,121,255,.28), rgba(255,111,179,.22), rgba(88,199,255,.26)); color: var(--fg); font: inherit; font-size: 1rem; cursor: pointer;
      -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
      transition: border-color .15s, background .15s, transform .12s, box-shadow .15s;
    }
    :global(.quiz-opt:hover:not(:disabled)) {
      border-color: var(--violet); background: linear-gradient(105deg, rgba(166,121,255,.45), rgba(255,111,179,.36), rgba(88,199,255,.4));
      transform: translateY(-1px); box-shadow: 0 6px 20px -12px rgba(166,121,255,.7);
    }
    :global(.quiz-opt:disabled) { cursor: default; }
    :global(.quiz-opt.is-correct) { border-color: transparent; background: var(--grad); color: #14101f; font-weight: 700; box-shadow: 0 8px 24px -12px rgba(255,111,179,.6); }
    :global(.quiz-opt.is-wrong) { border-color: rgba(239,68,68,.55); background: rgba(239,68,68,.14); }
    .quiz-note-line { margin: 1rem 0 0; font-size: .9rem; color: var(--fg-soft); }
    .quiz-next { margin-top: 1.1rem; }
    .quiz-end { text-align: center; background: var(--grad-soft); border: 1px solid var(--line-strong); border-radius: 20px; padding: 2rem 1.5rem; margin-top: 1rem; }
    .quiz-end h2 { font-family: var(--font-display); font-weight: 800; margin: 0 0 .6rem; }
    .quiz-verdict { color: var(--fg-soft); max-width: 32rem; margin: .8rem auto 1.4rem; font-size: 1rem; }
  </style>
</BaseLayout>
