---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedArticles, shortSlug } from '@/lib/articles';
import { CATEGORY_SLUGS, CATEGORY_META, type Category } from '@/config/taxonomy';
import { brand } from '@/config/brand';

export const getStaticPaths = (async () => {
  return CATEGORY_SLUGS.map((category) => ({ params: { category } }));
}) satisfies GetStaticPaths;

const category = Astro.params.category as Category;
const meta = CATEGORY_META[category];
const articles = await getPublishedArticles(category);
const piliers = articles.filter((a) => a.data.type === 'pilier');
const autres = articles.filter((a) => a.data.type !== 'pilier');
---
<BaseLayout
  title={`${meta.titre} — ${brand.name}`}
  description={meta.description}
  canonicalPath={`/${category}`}
  category={category}
  robots={articles.length === 0 ? 'noindex,follow' : 'index,follow'}
>
  <div class="hub">
    <p class="eyebrow">{meta.label}</p>
    <h1>{meta.titre}</h1>
    <p class="hub-lede">{meta.description}</p>

    {piliers.length > 0 && (
      <>
        <h2>Les guides</h2>
        <ul class="liste-articles">
          {piliers.map((a) => (
            <li>
              <a href={`/${category}/${shortSlug(a)}`}>
                <span class="li-titre">{a.data.titre_h1}</span>
                <span class="li-dek">{a.data.soustitre}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    {autres.length > 0 && (
      <>
        <h2>À lire aussi</h2>
        <ul class="liste-articles">
          {autres.map((a) => (
            <li>
              <a href={`/${category}/${shortSlug(a)}`}>
                <span class="li-titre">{a.data.titre_h1}</span>
                <span class="li-dek">{a.data.soustitre}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    {articles.length === 0 && <p class="hub-vide"><em>Les premiers articles arrivent très vite.</em></p>}
  </div>
</BaseLayout>
