---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedArticles, shortSlug } from '@/lib/articles';
import { CATEGORY_SLUGS, CATEGORY_META, type Category } from '@/config/taxonomy';
import { brand } from '@/config/brand';

export const getStaticPaths = (async () => {
  return CATEGORY_SLUGS.map((category) => ({ params: { category } }));
}) satisfies GetStaticPaths;

const category = Astro.params.category as Category;
const meta = CATEGORY_META[category];
const articles = await getPublishedArticles(category);
// Piliers en tête (mise en avant), puis le reste — une seule grille de cartes.
const ordered = [
  ...articles.filter((a) => a.data.type === 'pilier'),
  ...articles.filter((a) => a.data.type !== 'pilier'),
];

/** Vignette d'un article : son image hero (ou la première déclarée). */
function thumb(a: (typeof articles)[number]): string | undefined {
  const imgs = a.data.images ?? [];
  const hero = a.data.heroImage ? imgs.find((i) => i.id === a.data.heroImage) : imgs[0];
  return hero?.src;
}
---
<BaseLayout
  title={`${meta.titre} — ${brand.name}`}
  description={meta.description}
  canonicalPath={`/${category}`}
  category={category}
  robots={articles.length === 0 ? 'noindex,follow' : 'index,follow'}
>
  <div class="hub">
    <p class="eyebrow">{meta.label}</p>
    <h1>{meta.titre}</h1>
    <p class="hub-lede">{meta.description}</p>

    {ordered.length > 0 && (
      <ul class="card-grid">
        {ordered.map((a) => (
          <li>
            <a class="art-card" href={`/${category}/${shortSlug(a)}`}>
              <span class={`art-thumb cat-${category}`}>
                {thumb(a) && <img src={thumb(a)} alt="" loading="lazy" width="400" height="225" decoding="async" />}
              </span>
              <span class="art-body">
                <span class="art-titre">{a.data.titre_h1}</span>
                <span class="art-dek">{a.data.soustitre}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}

    {articles.length === 0 && <p class="hub-vide"><em>Les premiers articles arrivent très vite.</em></p>}
  </div>
</BaseLayout>
