---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brand } from '@/config/brand';
---
<BaseLayout
  title="Mentions légales"
  description="Mentions légales du média Brainrot."
  canonicalPath="/mentions-legales"
  robots="noindex,follow"
>
  <div class="prose">
    <h1>Mentions légales</h1>
    <p><em>Contenu à compléter avant mise en ligne.</em></p>
    <h2>Éditeur</h2>
    <p>{brand.name} — {brand.author}. Contact : <a href={`mailto:${brand.contactEmail}`}>{brand.contactEmail}</a>.</p>
    <h2>Hébergement</h2>
    <p>À préciser (Cloudflare Pages / Vercel).</p>
    <h2>Nature du contenu & affiliation</h2>
    <p>Média éditorial de divertissement. Certains liens sont affiliés et
    signalés comme tels ; ils n'influencent pas la ligne éditoriale.</p>
  </div>
</BaseLayout>
