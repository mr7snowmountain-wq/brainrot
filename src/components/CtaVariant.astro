---
/**
 * Bloc de pied d'article générique (promo d'app / affiliation) — un seul par
 * page, après les sources. Alimenté par le champ `cta` du frontmatter :
 *   cta: { label, href, soustitre?, track }
 * `track` sert au tracking (data-track). Divulgation d'affiliation obligatoire
 * quand le lien est affilié (à indiquer dans le corps ou le soustitre).
 */
interface Cta {
  label: string;
  href: string;
  soustitre?: string;
  track: string;
}
interface Props {
  cta: Cta;
}
const { cta } = Astro.props;
const external = /^https?:\/\//.test(cta.href);
---
<aside class="cta-fin">
  <a
    class="cta-hero"
    href={cta.href}
    data-track={cta.track}
    rel={external ? 'sponsored noopener' : undefined}
    target={external ? '_blank' : undefined}
  >
    {cta.label}
    {cta.soustitre && <small>{cta.soustitre}</small>}
  </a>
</aside>
